# Go serves both dashboard and admin API on ADMIN_PORT; mocks use MOCK_PORT.
PUBLIC_HOST=localhost
BIND_ADDRESS=127.0.0.1
ADMIN_PORT=5174
MOCK_PORT=5175
DATABASE_URL=postgres://mockman:CHANGE_ME@127.0.0.1:5432/mockman?sslmode=disable
DASHBOARD_ORIGIN=http://localhost:5174
MOCK_ALLOWED_ORIGINS=

# For your existing HTTPS Nginx proxy, set all three (no path in DASHBOARD_ORIGIN):
# DASHBOARD_ORIGIN=https://your-host
# ADMIN_ORIGIN=https://your-host/mockman-api/
# MOCK_ORIGIN=https://your-host/mockman-mock/
