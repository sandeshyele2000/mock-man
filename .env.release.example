# Copy to .env beside compose.release.yaml, then set your VPN hostname/IP.
PUBLIC_HOST=mac-studio.your-vpn-name
BIND_ADDRESS=0.0.0.0
DASHBOARD_PORT=5173
ADMIN_PORT=8080
MOCK_PORT=9091

# Browser client origins that may call mock APIs (comma-separated); otherwise empty.
MOCK_ALLOWED_ORIGINS=
MOCKMAN_VERSION=latest

# Optional public URLs for an HTTPS reverse proxy. DASHBOARD_ORIGIN has no path.
# DASHBOARD_ORIGIN=https://atlas.example.com
# ADMIN_ORIGIN=https://atlas.example.com/mockman-api/
# MOCK_ORIGIN=https://atlas.example.com/mockman-mock/
