# Copy to .env. Shared by Docker Compose, Go, Vite and the development launcher.
# For VPN access, change PUBLIC_HOST to the Mac Studio VPN name/IP and bind to 0.0.0.0.
PUBLIC_HOST=localhost
BIND_ADDRESS=127.0.0.1
DASHBOARD_PORT=5173
ADMIN_PORT=8080
MOCK_PORT=9091

# Used when running the backend directly; Docker uses its internal database service.
DATABASE_URL=postgres://mockman:mockman@127.0.0.1:54329/mockman?sslmode=disable
# Browser app origins allowed to call mock APIs (comma-separated).
# Leave empty if only native apps or server-side clients call the mocks.
MOCK_ALLOWED_ORIGINS=
# Configure as per need
MOCKMAN_VERSION=latest

# Optional public URLs for an HTTPS reverse proxy. DASHBOARD_ORIGIN has no path.
# DASHBOARD_ORIGIN=https://atlas.example.com
# ADMIN_ORIGIN=https://atlas.example.com/mockman-api/
# MOCK_ORIGIN=https://atlas.example.com/mockman-mock/
