# Copy to .env. Loaded by the Go backend, Vite and the development launcher.
DATABASE_URL=postgres://mockman:mockman@127.0.0.1:54329/mockman?sslmode=disable
ADMIN_ADDR=127.0.0.1:8080
ADMIN_ORIGIN=http://127.0.0.1:8080
DASHBOARD_ORIGIN=http://localhost:5173
MOCK_ADDR=127.0.0.1:9091
# MOCK_ALLOWED_ORIGINS=http://localhost:3000

# Optional public mock URL when MOCK_ADDR is a bind address such as 0.0.0.0:9091.
# MOCK_ORIGIN=http://192.168.1.10:9091
# Optional browser-only URL overrides (public values; never include secrets).
# VITE_API_URL=https://admin.example.com
# VITE_MOCK_URL=https://mock.example.com
